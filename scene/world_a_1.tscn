[node name="Label" type="Label" parent="." unique_id=651227061]
z_index = 1
offset_left = -35.0
offset_top = -12.0
offset_right = 531.0
offset_bottom = 63.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Où suis-je ?
Qu'est-ce qui m'arrive ?
Pourquoi est-ce que je ne vois presque rien ?"

[node name="Label2" type="Label" parent="." unique_id=1628274317]
z_index = 1
offset_left = 228.0
offset_top = -14.0
offset_right = 634.0
offset_bottom = 61.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Ah oui… C'est vrai, je suis un axolotl !
Mais qu'est-ce que je fais ici ?
Et pourquoi fait-il aussi chaud ?!"

[node name="Label3" type="Label" parent="." unique_id=302475945]
z_index = 1
offset_left = 448.0
offset_top = -14.0
offset_right = 1144.0
offset_bottom = 61.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Un slime !
Il n'a pas l'air très sympathique…
Heureusement, je peux me défendre avec mon jet d'eau !
Je devrais essayer de l'attaquer avec le clic gauche."

[node name="Label4" type="Label" parent="." unique_id=896110439]
z_index = 1
offset_left = 1032.0
offset_top = -23.0
offset_right = 1818.0
offset_bottom = 52.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Ouh là… Celui-là a l'air encore plus dangereux !
J'ai l'impression qu'il réagit à mon regard…
Si je le vise avec ma souris, il risque de foncer droit sur moi !
Mieux vaut éviter de trop le regarder…"

[node name="Label6" type="Label" parent="." unique_id=1995879531]
z_index = 1
offset_left = 1303.0
offset_top = -53.0
offset_right = 1543.0
offset_bottom = -9.666672
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "le grand saut..."

[node name="Label5" type="Label" parent="." unique_id=722903151]
z_index = 1
offset_left = 738.0
offset_top = -13.0
offset_right = 1371.333
offset_bottom = 79.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Le vide...
Du vide… Encore du vide…
Attends ! Une plateforme arrive !
Si je veux l'atteindre, il va falloir être rapide…
Ou plutôt… ralentir le temps !Grace a la touche Z."

[node name="Label7" type="Label" parent="." unique_id=763962615]
z_index = 1
offset_left = 4651.0
offset_top = 98.0
offset_right = 5491.0
offset_bottom = 190.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Enfin ! J'y suis arrivé !
Entre les slimes, les sauts impossibles et cette chaleur infernale…
J'ai bien cru que je n'allais jamais m'en sortir !
Maintenant, plus qu’à trouver un autre portail du Nether !"

[node name="Label8" type="Label" parent="." unique_id=19267976]
z_index = 1
offset_left = 1368.0
offset_top = 191.00002
offset_right = 2110.0
offset_bottom = 264.0
scale = Vector2(0.3, 0.3)
theme_override_fonts/font = ExtResource("14_03lke")
text = "Oh ! Un point de réapparition !
Enfin une bonne nouvelle !
Si jamais il m'arrive quelque chose, je pourrai revenir ici.
Je vais en profiter pour souffler un peu…"

